{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]],
      "start": ["${python}", "-m", "uvicorn", "main:app", "--port", "${PORT}"],
      "port": 8000,
      "port_env": "PORT",
      "health": { "path": "/api/health", "expect_status": [200] },
      "env": {
        "DATABASE_URL": { "dev": "sqlite:///./helpdesk.db" },
        "JWT_SECRET": { "generate": "hex", "bytes": 32 },
        "BACKEND_CORS_ORIGINS": { "dev": "http://localhost:5173" }
      }
    }
  ]
}
